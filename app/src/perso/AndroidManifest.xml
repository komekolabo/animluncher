<?xml version="1.0" encoding="utf-8"?>
<!-- VERSION PERSO uniquement : ajouté au manifeste commun (src/main) au moment de la compilation. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet : seulement pour envoyer le journal sur GitHub (si une clé a été donnée). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- FONDS D'ÉCRAN ANIMÉS : l'app en propose, mais elle reste installable sur un appareil qui ne sait
         pas les afficher (required="false"). -->
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />

    <application>
        <!-- (13/11) FOND 3D : demande aux services Google de télécharger l'outil de DÉTOURAGE dès
             l'installation de l'app (sinon il ne se télécharge qu'au premier fond 3D). Voir FabriqueFond3D.kt. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <!-- LES FONDS D'ÉCRAN ANIMÉS (12/11) : le même bloc que dans src/store/AndroidManifest.xml. -->
        <!-- L'aperçu plein écran d'un fond d'écran (avec « Appliquer »). Voir FondApercuActivity.kt. -->
        <activity
            android:name="com.will.animlauncher.FondApercuActivity"
            android:exported="false" />

        <!-- LES FONDS D'ÉCRAN ANIMÉS (voir FondService.kt) : deux services qu'Android appelle pour dessiner
             le fond de l'écran. permission BIND_WALLPAPER : seul Android peut s'y brancher.
             Ils apparaissent dans la liste des fonds animés du téléphone. -->
        <service
            android:name="com.will.animlauncher.FondDessinService"
            android:exported="true"
            android:label="@string/fd_service_dessin"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/fond_dessin" />
        </service>
        <service
            android:name="com.will.animlauncher.FondVideoService"
            android:exported="true"
            android:label="@string/fd_service_video"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/fond_video" />
        </service>
    </application>
</manifest>
