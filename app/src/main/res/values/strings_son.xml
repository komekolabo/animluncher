<!-- Sound reaction texts (the round button at the bottom right of the home screen). See ReactionSonoreUi.kt. -->
<resources>
    <string name="son_titre">Sound reaction</string>
    <string name="son_expl_mode">The edges of your screen move softly to the rhythm of your phone’s music, even outside the app.</string>
    <string name="son_expl_rien">Nothing is recorded or saved.</string>
    <string name="son_expl_direct">The app only reads the sound level, live, and forgets it instantly.</string>
    <string name="son_expl_internet">This app has no Internet access.</string>
    <string name="son_expl_video">The effect hides itself in full-screen videos and games, and only runs while music is playing.</string>
    <string name="son_expl_micro">Android will ask for microphone access: it is required to read the sound level.</string>
    <string name="son_service">Turn on AnimLauncher in the Accessibility settings first: the effect needs it to appear.</string>
    <string name="son_style">Style</string>
    <string name="son_style_1">Aurora</string>
    <string name="son_desc_1">A curtain of light that swells with the bass</string>
    <string name="son_style_2">Strings</string>
    <string name="son_desc_2">Three strings per edge: bass, melody, treble</string>
    <string name="son_style_3">Liquid glass</string>
    <string name="son_desc_3">The edge bulges and ripples like a soft material</string>
    <string name="son_style_4">Prism</string>
    <string name="son_desc_4">A thin neon: each sound lights up its own zone</string>
