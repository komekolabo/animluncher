<?xml version="1.0" encoding="utf-8"?>
<!-- Le style de l'écran du DOSSIER ANIMÉ (DossierActivity) : transparent (on voit l'accueil derrière),
     sans barre de titre, et sans l'animation d'ouverture d'Android (c'est nous qui animons). -->
<resources>
    <style name="Theme.Dossier" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
