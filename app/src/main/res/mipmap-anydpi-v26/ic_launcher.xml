<?xml version="1.0" encoding="utf-8"?>
<!-- L'ICÔNE DE L'APP (format « adaptatif » d'Android) : un fond sombre + le logo par-dessus.
     « monochrome » sert aux icônes thématisées (quand le téléphone colore toutes les icônes). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/logo_fond" />
    <foreground android:drawable="@drawable/logo_avant" />
    <monochrome android:drawable="@drawable/logo_mono" />
</adaptive-icon>
