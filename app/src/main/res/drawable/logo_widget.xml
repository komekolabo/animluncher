<?xml version="1.0" encoding="utf-8"?>
<!-- LE LOGO DU WIDGET, immobile (le dessin de départ). C'est le logo « Étincelle halo » (même dessin
     que logo_avant.xml), posé sur la forme d'icône de Samsung, pour que le widget ressemble à une
     vraie icône. Les morceaux qui bougent ont un NOM (android:name) : c'est grâce à ces noms que
     l'animation (logo_widget_anime.xml) sait quoi faire bouger.
     Dessin en 100 x 100 = toute l'icône. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- le fond : la forme d'icône de Samsung (une « super-ellipse », plus ronde qu'un carré aux
         coins arrondis), de la même couleur que l'icône d'AnimLauncher -->
    <path
        android:fillColor="@color/logo_fond"
        android:pathData="M100.00,50.00 L99.92,56.14 99.67,60.44 99.26,64.22 98.68,67.68 97.95,70.88 97.05,73.88 95.98,76.70 94.76,79.34 93.38,81.81 91.84,84.13 90.15,86.29 88.30,88.30 86.29,90.15 84.13,91.84 81.81,93.38 79.34,94.76 76.70,95.98 73.88,97.05 70.88,97.95 67.68,98.68 64.22,99.26 60.44,99.67 56.14,99.92 50.00,100.00 43.86,99.92 39.56,99.67 35.78,99.26 32.32,98.68 29.12,97.95 26.12,97.05 23.30,95.98 20.66,94.76 18.19,93.38 15.87,91.84 13.71,90.15 11.70,88.30 9.85,86.29 8.16,84.13 6.62,81.81 5.24,79.34 4.02,76.70 2.95,73.88 2.05,70.88 1.32,67.68 0.74,64.22 0.33,60.44 0.08,56.14 0.00,50.00 0.08,43.86 0.33,39.56 0.74,35.78 1.32,32.32 2.05,29.12 2.95,26.12 4.02,23.30 5.24,20.66 6.62,18.19 8.16,15.87 9.85,13.71 11.70,11.70 13.71,9.85 15.87,8.16 18.19,6.62 20.66,5.24 23.30,4.02 26.12,2.95 29.12,2.05 32.32,1.32 35.78,0.74 39.56,0.33 43.86,0.08 50.00,0.00 56.14,0.08 60.44,0.33 64.22,0.74 67.68,1.32 70.88,2.05 73.88,2.95 76.70,4.02 79.34,5.24 81.81,6.62 84.13,8.16 86.29,9.85 88.30,11.70 90.15,13.71 91.84,15.87 93.38,18.19 94.76,20.66 95.98,23.30 97.05,26.12 97.95,29.12 98.68,32.32 99.26,35.78 99.67,39.56 99.92,43.86 Z" />

    <!-- On passe dans la grille 108 x 108 du logo d'origine : sur la vraie icône, 69,5 unités de cette
         grille occupent toute la largeur (mesuré sur une capture d'écran le 09/11). Donc on agrandit
         de 100 / 69,5 autour du centre (54, 54), et on recale ce centre au milieu (50, 50). -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.4388"
        android:scaleY="1.4388"
        android:translateX="-4"
        android:translateY="-4">

        <!-- même réduction à 80 % que l'icône -->
        <group
            android:pivotX="54"
            android:pivotY="54"
            android:scaleX="0.8"
            android:scaleY="0.8">

            <!-- l'ombre au sol : elle rétrécit quand le logo monte (nom : « ombre ») -->
            <group
                android:name="ombre"
                android:pivotX="54"
                android:pivotY="88">
                <path android:pathData="M34,88 A20,2 0 1,1 74,88 A20,2 0 1,1 34,88 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="radial"
                            android:centerX="54"
                            android:centerY="88"
                            android:gradientRadius="20">
                            <item android:offset="0" android:color="#6E000000" />
                            <item android:offset="1" android:color="#00000000" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>

            <!-- tout ce qui lévite (nom : « flottant ») -->
            <group android:name="flottant">

                <!-- le halo doux (nom : « halo » : il respire avec la lévitation) -->
                <path
                    android:name="halo"
                    android:fillAlpha="0.6"
                    android:pathData="M54,45 A16,16 0 1,1 54,77 A16,16 0 1,1 54,45 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="radial"
                            android:centerX="54"
                            android:centerY="61"
                            android:gradientRadius="16">
                            <item android:offset="0" android:color="#47F7C948" />
                            <item android:offset="1" android:color="#00F7C948" />
                        </gradient>
                    </aapt:attr>
                </path>

                <!-- les trois coins du triangle, qui font de temps en temps un tiers de tour
                     autour du centre du triangle (nom : « tour ») -->
                <group
                    android:name="tour"
                    android:pivotX="54"
                    android:pivotY="61">
                    <path
                        android:pathData="M44.5,45.2 L54,29 L63.5,45.2 M35.5,60.8 L26,77 L45,77 M63,77 L82,77 L72.5,60.8"
                        android:strokeColor="#ECEFF7"
                        android:strokeWidth="8"
                        android:strokeLineCap="round"
                        android:strokeLineJoin="round"
                        android:fillColor="#00000000" />
                </group>

                <!-- l'étoile en dégradé, qui scintille (nom : « etoile ») -->
                <group
                    android:name="etoile"
                    android:pivotX="54"
                    android:pivotY="61">
                    <path android:pathData="M54,50.5 L56.4,58.6 L64.5,61 L56.4,63.4 L54,71.5 L51.6,63.4 L43.5,61 L51.6,58.6 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="43.5"
                                android:startY="50.5"
                                android:endX="64.5"
                                android:endY="71.5">
                                <item android:offset="0" android:color="#4C8DF6" />
                                <item android:offset="0.38" android:color="#34C77B" />
                                <item android:offset="0.66" android:color="#F7C948" />
                                <item android:offset="1" android:color="#F0645A" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
            </group>
        </group>
    </group>
</vector>
