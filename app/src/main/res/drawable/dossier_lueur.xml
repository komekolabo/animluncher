<?xml version="1.0" encoding="utf-8"?>
<!-- LA LUEUR ROSE TRÈS DOUCE derrière l'étoile du widget « dossier animé » (10/11, voir WidgetDossier.kt).
     Avant, elle était dessinée dans chaque image du folioscope. Maintenant elle est à part (couche du
     dessous), pour que les images du folioscope ne couvrent que le MILIEU du galet : 3 fois moins de
     pixels, donc 2 fois plus d'images par seconde dans la même mémoire. Repère 100 x 100, centre (50, 48). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="62dp" android:height="62dp" android:viewportWidth="100" android:viewportHeight="100">
    <group android:name="lueur_g" android:pivotX="50" android:pivotY="48">
        <path android:pathData="M50,10 A38,38 0 1,1 49.99,10 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="50" android:centerY="48" android:gradientRadius="38">
                    <item android:offset="0" android:color="#40FF6B7A" />
                    <item android:offset="0.45" android:color="#1AFF4B3A" />
                    <item android:offset="1" android:color="#00FF4B3A" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
