<?xml version="1.0" encoding="utf-8"?>
<!-- LA BOUCLE DU WIDGET « DOSSIER ANIMÉ » (12 s, recommence sans fin), validée par Will sur l'aperçu.
     0-3 s : l'étoile respire et tourne doucement. 3-3,6 s : elle tourne vite et rétrécit ; 4 points
     jaillissent. 3,6-6,4 s : les points font trois quarts de tour en traçant un anneau qui s'efface.
     6,4-7,4 s : ils deviennent 4 tuiles. 7,6-9,7 s : une vague passe deux fois sur les tuiles.
     9,8-10,6 s : les tuiles rentrent au centre. 10,4-11,2 s : l'étoile renaît avec un ressort.
     Une « keyframe » = la valeur à un instant (fraction de la boucle : 0,5 = 6 s), et l'« interpolator »
     dit comment on y arrive (en douceur, en accélérant, avec un petit dépassement…).
     Fichier fabriqué par un programme : outils/generer_avd.py (le modifier là-bas, puis relancer). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/etoile_ia">

    <!-- la lueur faiblit pendant que les points et les tuiles jouent -->
    <target android:name="lueur">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="12000" android:repeatCount="infinite" android:interpolator="@android:interpolator/linear">
<propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
  <keyframe android:fraction="0.0" android:value="1" />
  <keyframe android:fraction="0.25" android:value="1" android:interpolator="@interpolator/lin" />
  <keyframe android:fraction="0.3" android:value="0.35" android:interpolator="@interpolator/doux" />
  <keyframe android:fraction="0.8667" android:value="0.35" android:interpolator="@interpolator/lin" />
  <keyframe android:fraction="0.9333" android:value="1" android:interpolator="@interpolator/doux" />
  <keyframe android:fraction="1.0" android:value="1" android:interpolator="@interpolator/lin" />
</propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- la lueur respire (toutes les 3 s) -->
