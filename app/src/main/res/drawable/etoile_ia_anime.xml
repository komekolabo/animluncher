  <keyframe android:fraction="0.5" android:value="1" android:interpolator="@interpolator/doux" />
  <keyframe android:fraction="0.625" android:value="1.06" android:interpolator="@interpolator/doux" />
  <keyframe android:fraction="0.75" android:value="1" android:interpolator="@interpolator/doux" />
  <keyframe android:fraction="0.875" android:value="1.06" android:interpolator="@interpolator/doux" />
  <keyframe android:fraction="1.0" android:value="1" android:interpolator="@interpolator/doux" />
</propertyValuesHolder>
<propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
