<?xml version="1.0" encoding="utf-8"?>
<!-- LE LOGO (premier plan). Une icône d'app (le carré arrondi), entourée d'une comète qui file
     autour d'elle et finit en étincelle : « une animation qui accompagne l'ouverture de tes apps ».
     Dessin en 108 x 108 : Android découpe ensuite l'icône (rond, carré, goutte…) selon le téléphone,
     donc tout l'important reste dans le cercle central de 66 de diamètre. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- l'icône d'app, au centre : un carré aux coins arrondis, en trait clair -->
    <path
        android:pathData="M45.6,36 L62.4,36 Q72,36 72,45.6 L72,62.4 Q72,72 62.4,72 L45.6,72 Q36,72 36,62.4 L36,45.6 Q36,36 45.6,36 Z"
        android:strokeColor="#E8ECF7"
        android:strokeWidth="3.6"
        android:fillColor="#00000000" />

    <!-- un petit point au milieu de l'icône : l'app qui « s'allume » -->
    <path
        android:pathData="M54,50.4 A3.6,3.6 0 1,1 54,57.6 A3.6,3.6 0 1,1 54,50.4 Z"
        android:fillColor="@color/logo_couleur" />

    <!-- la traîne de la comète (plus fine et transparente) -->
    <path
        android:pathData="M26.16,61.44 A28.8,28.8 0 0,1 29.04,68.4"
        android:strokeColor="@color/logo_couleur"
        android:strokeAlpha="0.4"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- la comète : un arc qui part d'en bas à gauche, passe au-dessus de l'icône et file vers la droite -->
    <path
        android:pathData="M29.04,68.4 A28.8,28.8 0 0,1 76.08,35.52"
        android:strokeColor="@color/logo_couleur"
        android:strokeWidth="4.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- l'étincelle au bout de la comète (une étoile à 4 branches) -->
    <path
        android:pathData="M76.08,28.32 L77.88,33.72 L83.48,35.52 L77.88,37.32 L76.08,42.72 L74.28,37.32 L68.68,35.52 L74.28,33.72 Z"
        android:fillColor="#FFFFFF" />
</vector>
