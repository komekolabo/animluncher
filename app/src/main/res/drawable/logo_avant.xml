<?xml version="1.0" encoding="utf-8"?>
<!-- LE LOGO (premier plan) : « Étincelle halo », choisi par Will le 09/11.
     Un triangle dont les trois côtés sont coupés en leur milieu (il ne reste que les trois coins),
     avec au centre une étoile à 4 branches en dégradé (bleu, vert, jaune, rouge) posée sur un
     halo doux. Idée : le déclic de l'animation au cœur de l'app.
     Dessin en 108 x 108 : Android découpe ensuite l'icône (rond, carré, goutte…) selon le téléphone,
     donc tout l'important doit rester dans le cercle central de 66 de diamètre. Le dessin d'origine
     (fait sur le canevas) est un peu trop grand : le groupe le réduit à 80 % autour du centre. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">

        <!-- le halo : un disque dont la couleur s'efface du centre vers le bord (jamais de flash) -->
        <path android:pathData="M54,45 A16,16 0 1,1 54,77 A16,16 0 1,1 54,45 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="54"
                    android:centerY="61"
                    android:gradientRadius="16">
                    <item android:offset="0" android:color="#47F7C948" />
                    <item android:offset="1" android:color="#00F7C948" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- les trois coins du triangle : traits épais, bouts arrondis -->
        <path
            android:pathData="M44.5,45.2 L54,29 L63.5,45.2 M35.5,60.8 L26,77 L45,77 M63,77 L82,77 L72.5,60.8"
            android:strokeColor="#ECEFF7"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

        <!-- l'étoile à 4 branches, en dégradé d'un coin à l'autre (en diagonale) -->
        <path android:pathData="M54,50.5 L56.4,58.6 L64.5,61 L56.4,63.4 L54,71.5 L51.6,63.4 L43.5,61 L51.6,58.6 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="43.5"
                    android:startY="50.5"
                    android:endX="64.5"
                    android:endY="71.5">
                    <item android:offset="0" android:color="#4C8DF6" />
                    <item android:offset="0.38" android:color="#34C77B" />
                    <item android:offset="0.66" android:color="#F7C948" />
                    <item android:offset="1" android:color="#F0645A" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
