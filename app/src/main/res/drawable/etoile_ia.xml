<?xml version="1.0" encoding="utf-8"?>
<!-- LE DESSIN DU WIDGET « DOSSIER ANIMÉ » (09/11), fabriqué par un petit programme (aperçu de Will :
     boucle_etoile.py, palette chaude). Repère 100 x 100 = tout le galet, centre (50, 48).
     Chaque morceau a un nom : etoile_ia_anime.xml dit comment chacun bouge pendant la boucle de 12 s.
     Au repos (avant l'animation) on ne voit que l'étoile ; les points, l'anneau et les tuiles
     commencent invisibles (taille 0 ou trait vide). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="62dp" android:height="62dp" android:viewportWidth="100" android:viewportHeight="100">

    <!-- la lueur rose très douce derrière (jamais de flash) -->
    <group android:name="lueur_g" android:pivotX="50" android:pivotY="48">
        <path android:name="lueur" android:pathData="M50,10 A38,38 0 1,1 49.99,10 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="50" android:centerY="48" android:gradientRadius="38">
                    <item android:offset="0" android:color="#40FF6B7A" />
                    <item android:offset="0.45" android:color="#1AFF4B3A" />
                    <item android:offset="1" android:color="#00FF4B3A" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- 1) l'étoile : elle tourne (etoile_tour) et change de taille (etoile_taille) -->
    <group android:name="etoile_tour" android:pivotX="50" android:pivotY="48">
        <group android:name="etoile_taille" android:pivotX="50" android:pivotY="48">
            <path android:pathData="M50,22 Q52.21,45.79 76,48 Q52.21,50.21 50,74 Q47.79,50.21 24,48 Q47.79,45.79 50,22 Z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="24" android:startY="22" android:endX="76" android:endY="74">
                        <item android:offset="0" android:color="#FF8C5B" />
                        <item android:offset="0.5" android:color="#FF6B9B" />
                        <item android:offset="1" android:color="#C4D13F" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>

    <!-- 2) l'anneau : un cercle dont on ne trace qu'un morceau (trimPathStart / trimPathEnd) -->
    <group android:name="anneau_tour" android:pivotX="50" android:pivotY="48" android:rotation="-90">
        <path android:name="anneau" android:pathData="M72,48 A22,22 0 1,1 28,48 A22,22 0 1,1 72,48"
            android:strokeColor="#96FFFFFF" android:strokeWidth="1.4" android:strokeLineCap="round"
            android:trimPathStart="0" android:trimPathEnd="0" />
    </group>

    <!-- 3) les 4 points (posés à 22 du centre, sur les diagonales) : le groupe « orbite » tourne, et le
         groupe « rayon » grandit depuis le centre (les points jaillissent), puis rapetisse (ils filent
         vers la place des tuiles, puis disparaissent au centre, cachés par les tuiles) -->
    <group android:name="orbite" android:pivotX="50" android:pivotY="48">
        <group android:name="rayon" android:pivotX="50" android:pivotY="48" android:scaleX="0" android:scaleY="0">
            <group android:pivotX="50" android:pivotY="48" android:rotation="-45">
                <path android:fillColor="#30FF8C5B" android:pathData="M78,48 A6,6 0 1,1 66,48 A6,6 0 1,1 78,48 Z" />
                <path android:fillColor="#FF8C5B" android:pathData="M75.4,48 A3.4,3.4 0 1,1 68.6,48 A3.4,3.4 0 1,1 75.4,48 Z" />
            </group>
            <group android:pivotX="50" android:pivotY="48" android:rotation="45">
                <path android:fillColor="#30FF6B9B" android:pathData="M78,48 A6,6 0 1,1 66,48 A6,6 0 1,1 78,48 Z" />
                <path android:fillColor="#FF6B9B" android:pathData="M75.4,48 A3.4,3.4 0 1,1 68.6,48 A3.4,3.4 0 1,1 75.4,48 Z" />
            </group>
            <group android:pivotX="50" android:pivotY="48" android:rotation="135">
                <path android:fillColor="#30C4D13F" android:pathData="M78,48 A6,6 0 1,1 66,48 A6,6 0 1,1 78,48 Z" />
                <path android:fillColor="#C4D13F" android:pathData="M75.4,48 A3.4,3.4 0 1,1 68.6,48 A3.4,3.4 0 1,1 75.4,48 Z" />
            </group>
            <group android:pivotX="50" android:pivotY="48" android:rotation="225">
                <path android:fillColor="#30FF7B6F" android:pathData="M78,48 A6,6 0 1,1 66,48 A6,6 0 1,1 78,48 Z" />
                <path android:fillColor="#FF7B6F" android:pathData="M75.4,48 A3.4,3.4 0 1,1 68.6,48 A3.4,3.4 0 1,1 75.4,48 Z" />
            </group>
        </group>
    </group>

    <!-- 4) les 4 tuiles (un petit dossier 2 x 2) : chacune se place (tuile_i) et change de taille (tuile_taille_i) -->
    <group android:name="tuile_0">
        <group android:name="tuile_taille_0" android:pivotX="50" android:pivotY="48" android:scaleX="0" android:scaleY="0">
            <path android:pathData="M46.4,41 L53.6,41 Q57,41 57,44.4 L57,51.6 Q57,55 53.6,55 L46.4,55 Q43,55 43,51.6 L43,44.4 Q43,41 46.4,41 Z"
                android:strokeColor="#40FFFFFF" android:strokeWidth="0.8">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="50" android:startY="41" android:endX="50" android:endY="55">
                        <item android:offset="0" android:color="#FF8C5B" />
                        <item android:offset="1" android:color="#AAFF8C5B" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>
    <group android:name="tuile_1">
        <group android:name="tuile_taille_1" android:pivotX="50" android:pivotY="48" android:scaleX="0" android:scaleY="0">
            <path android:pathData="M46.4,41 L53.6,41 Q57,41 57,44.4 L57,51.6 Q57,55 53.6,55 L46.4,55 Q43,55 43,51.6 L43,44.4 Q43,41 46.4,41 Z"
                android:strokeColor="#40FFFFFF" android:strokeWidth="0.8">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="50" android:startY="41" android:endX="50" android:endY="55">
                        <item android:offset="0" android:color="#FF6B9B" />
                        <item android:offset="1" android:color="#AAFF6B9B" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>
    <group android:name="tuile_2">
        <group android:name="tuile_taille_2" android:pivotX="50" android:pivotY="48" android:scaleX="0" android:scaleY="0">
            <path android:pathData="M46.4,41 L53.6,41 Q57,41 57,44.4 L57,51.6 Q57,55 53.6,55 L46.4,55 Q43,55 43,51.6 L43,44.4 Q43,41 46.4,41 Z"
                android:strokeColor="#40FFFFFF" android:strokeWidth="0.8">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="50" android:startY="41" android:endX="50" android:endY="55">
                        <item android:offset="0" android:color="#C4D13F" />
                        <item android:offset="1" android:color="#AAC4D13F" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>
    <group android:name="tuile_3">
        <group android:name="tuile_taille_3" android:pivotX="50" android:pivotY="48" android:scaleX="0" android:scaleY="0">
            <path android:pathData="M46.4,41 L53.6,41 Q57,41 57,44.4 L57,51.6 Q57,55 53.6,55 L46.4,55 Q43,55 43,51.6 L43,44.4 Q43,41 46.4,41 Z"
                android:strokeColor="#40FFFFFF" android:strokeWidth="0.8">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="50" android:startY="41" android:endX="50" android:endY="55">
                        <item android:offset="0" android:color="#FF7B6F" />
                        <item android:offset="1" android:color="#AAFF7B6F" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>
</vector>
