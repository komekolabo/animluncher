<?xml version="1.0" encoding="utf-8"?>
<!-- LE WIDGET « DOSSIER ANIMÉ » (09/11, voir WidgetGroupe.kt). Trois couches empilées (FrameLayout) :
       1) le galet de verre brun chaud (widget_galet_chaud.xml) ;
       2) la « mini-vidéo » de 12 s en boucle : l'étoile, les points qui tournent, les tuiles…
          (une ProgressBar joue etoile_ia_anime.xml en boucle) ;
       3) la bande de lumière qui traverse le verre toutes les 6 s.
     La COULEUR choisie avec la roue du dossier est posée par-dessus le galet et l'étoile (« teinte »,
     voir WidgetGroupe.vues), d'où les identifiants widget_groupe_galet et widget_groupe_etoile.
     Puis le nom du groupe dessous (« AI », « Games »…). Un appui ouvre le dossier (DossierActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_groupe_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp">

        <ImageView
            android:id="@+id/widget_groupe_galet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_galet_chaud" />

        <ProgressBar
            android:id="@+id/widget_groupe_etoile"
            style="@android:style/Widget.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minWidth="62dp"
            android:maxWidth="62dp"
            android:minHeight="62dp"
            android:maxHeight="62dp"
            android:indeterminate="true"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/etoile_ia_anime" />

        <ProgressBar
            style="@android:style/Widget.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minWidth="62dp"
            android:maxWidth="62dp"
            android:minHeight="62dp"
            android:maxHeight="62dp"
            android:indeterminate="true"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/widget_galet_reflet_anime" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_groupe_nom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="AI"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
