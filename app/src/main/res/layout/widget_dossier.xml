<?xml version="1.0" encoding="utf-8"?>
<!-- LE WIDGET « DOSSIER ANIMÉ » AVEC LES VRAIES ICÔNES (10/11, voir WidgetDossier.kt). Même gabarit que
     widget_groupe.xml : un galet de 62 dp, puis le nom du dossier dessous. Trois couches empilées :
       1) le galet de verre brun chaud (teinté par la roue des couleurs, comme avant) ;
       2) la lueur rose qui respire, puis le FOLIOSCOPE (dossier_film) : les 300 images de la boucle de 12 s
          (étoile, points, icônes des apps), dessinées par AnimLauncher. La visionneuse les fait défiler
          toute seule, une toutes les 40 ms (25 par seconde), et recommence au début quand elle arrive au bout ;
       3) la bande de lumière qui traverse le verre toutes les 6 s (inchangée). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dossier_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp">

        <ImageView
            android:id="@+id/dossier_galet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_galet_chaud" />

        <!-- la lueur qui respire, derrière le logo (rose pour l'IA ; de la couleur du logo pour les autres
             dossiers, voir WidgetDossier.vues) -->
        <ProgressBar
            android:id="@+id/dossier_lueur"
            style="@android:style/Widget.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minWidth="62dp"
            android:maxWidth="62dp"
            android:minHeight="62dp"
            android:maxHeight="62dp"
            android:indeterminate="true"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/dossier_lueur_anime" />

        <!-- le folioscope ne couvre que le MILIEU du galet (54 dp sur 62 depuis le 18/11, 42 avant ; centré sur
             l'étoile, qui est à 31 dp du bord gauche et 29,76 dp du haut) : tout ce qui bouge y tient -> 25 images par
             seconde (une toutes les 40 ms) -->
        <ViewFlipper
            android:id="@+id/dossier_film"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="2.76dp"
            android:autoStart="true"
            android:flipInterval="40" />

        <ProgressBar
            style="@android:style/Widget.ProgressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minWidth="62dp"
            android:maxWidth="62dp"
            android:minHeight="62dp"
            android:maxHeight="62dp"
            android:indeterminate="true"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/widget_galet_reflet_anime" />

        <!-- (18/11) LES INFOS UTILES, par-dessus la boucle. Ce sont des vues à part (pas dans les 300 images) :
             les mettre à jour est instantané (voir WidgetDossier.poserInfos).
             En haut à droite : le nombre d'apps du dossier encore OUVERTES (point vert + chiffre), cachée s'il n'y en a pas. -->
        <LinearLayout
            android:id="@+id/dossier_ouvertes"
            android:layout_width="wrap_content"
            android:layout_height="11dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/dossier_pastille"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingLeft="3dp"
            android:paddingEnd="4dp"
            android:paddingRight="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:src="@drawable/dossier_point_vert" />

            <TextView
                android:id="@+id/dossier_ouvertes_nb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginLeft="2dp"
                android:includeFontPadding="false"
                android:text="1"
                android:textColor="#E1F5E8"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- En bas à droite : l'icône de la DERNIÈRE app utilisée du dossier, dans un petit rond (cachée pour un
             dossier d'une seule app, et tant qu'aucune n'a été ouverte). -->
        <FrameLayout
            android:id="@+id/dossier_derniere"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="1dp"
            android:layout_marginRight="1dp"
            android:layout_marginBottom="1dp"
            android:background="@drawable/dossier_rond"
            android:visibility="gone">

            <ImageView
                android:id="@+id/dossier_derniere_icone"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/dossier_nom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="AI"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- (18/11) LE NOM DANS UNE AUTRE POLICE (gothique, pixel…) : un widget ne peut pas changer la police d'un texte,
         alors l'app dessine le nom dans une image, affichée ici À LA PLACE du texte du dessus (voir Polices.poserNom).
         Caché tant que le dossier garde la police du téléphone. (marge de 1 dp : l'image contient déjà l'ombre) -->
    <ImageView
        android:id="@+id/dossier_nom_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="gone" />
</LinearLayout>
