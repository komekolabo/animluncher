<?xml version="1.0" encoding="utf-8"?>
<!-- Réglages du service : quels événements on veut recevoir.
     typeWindowStateChanged = "une app (ou son écran de lancement) passe au premier plan".
     notificationTimeout=0 : événements livrés sans délai.
     On ne lit pas le contenu des écrans (canRetrieveWindowContent=false). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canRetrieveWindowContent="false"
    android:description="@string/description_service" />
