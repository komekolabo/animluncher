<?xml version="1.0" encoding="utf-8"?>
<!-- La fiche du widget « dossier animé » : 1 x 1 case, jamais de mise à jour automatique
     (l'étoile tourne toute seule). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_groupe"
    android:previewLayout="@layout/widget_groupe"
    android:previewImage="@drawable/etoile_ia"
    android:description="@string/widget_groupe_description"
    android:widgetCategory="home_screen" />
