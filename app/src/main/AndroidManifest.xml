<?xml version="1.0" encoding="utf-8"?>
<!-- La "carte d'identité" de l'app : son nom, ses écrans, ses services. -->
<!-- Ce fichier est COMMUN aux deux versions. Ce qui ne concerne que ta version Perso
     (Internet, mode standard) est dans src/perso/AndroidManifest.xml : Android fusionne les deux. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- RÉACTION SONORE (option, éteinte de base) : pour lire en direct le NIVEAU du son que joue le
         téléphone (outil « Visualizer »), Android exige ces deux permissions. La première s'appelle
         « enregistrer l'audio » mais l'app n'enregistre rien : elle n'est demandée à l'utilisateur
         que s'il allume le mode, après un écran d'explication. Voir EcouteSon.kt. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Depuis Android 11, une app ne "voit" pas les autres apps par défaut.
         On demande à voir : les apps qui ont une icône, et l'écran d'accueil. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- enableOnBackInvokedCallback="false" : avec Android 16, le bouton « retour » ne prévient plus
         les écrans de la même façon. Trois de nos écrans s'en servent (fermer le menu de l'accueil,
         finir l'édition d'un dossier…) : on garde l'ancien fonctionnement, qui marche toujours. -->
    <application
        android:name=".AnimApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- L'écran principal, avec son icône dans le tiroir d'applications. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Les réglages (la roue de l'accueil : c'est l'ancien écran principal) et l'écran
             « Fonds d'écran » (carte 3 de l'accueil). Refonte du 09/11. -->
        <activity
            android:name=".ReglagesActivity"
            android:exported="false" />
        <activity
            android:name=".FondsActivity"
            android:exported="false" />

        <!-- L'écran Journal (pas d'icône : on y accède depuis l'écran principal). -->
        <activity
            android:name=".JournalActivity"
            android:exported="false" />

        <!-- La liste des apps, et les réglages d'une app (durée, variantes, aperçu). -->
        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReglageAppActivity"
            android:exported="false" />

        <!-- Les DOSSIERS ANIMÉS : l'écran qui range les apps par groupe (GroupesActivity), et le dossier
             lui-même (DossierActivity), transparent par-dessus l'accueil. Le dossier vit dans sa propre
             tâche (taskAffinity vide) et n'apparaît pas dans les apps récentes : il ne s'ouvre jamais
             par-dessus l'écran principal d'AnimLauncher. -->
        <activity
            android:name=".GroupesActivity"
            android:exported="false" />
        <activity
            android:name=".DossierActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Dossier" />
        <!-- La feuille pour ajouter une app à un dossier (le « + ») : transparente, comme le dossier (style Theme.Feuille). -->
        <activity
            android:name=".ChoixAppActivity"
            android:exported="false"
            android:theme="@style/Theme.Feuille"
            android:windowSoftInputMode="adjustResize" />

        <!-- Le guide plein écran pour débloquer l'accessibilité grisée (apps installées hors Play Store). -->
        <activity
            android:name=".GuideDeblocage"
            android:exported="false" />

        <!-- RÉACTION SONORE, option « Écran éteint, tour allumé » : un écran tout noir qui se pose quand on
             éteint le téléphone pendant une musique (le tour lumineux se dessine par-dessus). Il vit dans sa
             propre tâche et n'apparaît pas dans les apps récentes. Voir VeilleSon.kt. -->
        <activity
            android:name=".VeilleSonActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="" />

        <!-- Le service qui détecte l'app ouverte et joue l'animation. -->
        <service
            android:name=".AppWatcherService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- LE WIDGET « LOGO ANIMÉ » (voir LogoWidget.kt) : il apparaît dans la liste des widgets
             de l'écran d'accueil. exported="false" : seul Android peut lui parler. -->
        <receiver
            android:name=".LogoWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_logo_info" />
        </receiver>

        <!-- LE WIDGET « UNE APP DANS UN GALET » (essai, voir WidgetApp.kt). -->
        <receiver
            android:name=".WidgetApp"
            android:exported="false"
            android:label="@string/widget_app_titre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_app_info" />
        </receiver>

        <!-- LE WIDGET « DOSSIER ANIMÉ » (voir WidgetGroupe.kt). -->
        <receiver
            android:name=".WidgetGroupe"
            android:exported="false"
            android:label="@string/widget_groupe_titre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_groupe_info" />
        </receiver>

        <!-- Le KILL SWITCH : un bouton dans le volet des réglages rapides. -->
        <service
            android:name=".InterrupteurTile"
            android:exported="true"
            android:icon="@android:drawable/ic_media_pause"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
