<?xml version="1.0" encoding="utf-8"?>
<!-- La "carte d'identité" de l'app : son nom, ses écrans, ses services. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Depuis Android 11, une app ne "voit" pas les autres apps par défaut.
         On demande à voir : les apps qui ont une icône, et l'écran d'accueil. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:label="AnimLauncher"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- L'écran principal, avec son icône dans le tiroir d'applications. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- L'écran Journal (pas d'icône : on y accède depuis l'écran principal). -->
        <activity
            android:name=".JournalActivity"
            android:exported="false" />

        <!-- Le service qui détecte l'app ouverte et joue l'animation. -->
        <service
            android:name=".AppWatcherService"
            android:exported="true"
            android:label="AnimLauncher"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Le KILL SWITCH : un bouton dans le volet des réglages rapides. -->
        <service
            android:name=".InterrupteurTile"
            android:exported="true"
            android:icon="@android:drawable/ic_media_pause"
            android:label="AnimLauncher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
