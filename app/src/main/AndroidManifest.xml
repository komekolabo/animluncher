<?xml version="1.0" encoding="utf-8"?>
<!-- La "carte d'identité" de l'app : son nom, ses écrans, ses services. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Depuis Android 11, une app ne "voit" pas les autres apps par défaut.
         On demande à voir : les apps qui ont une icône, et l'écran d'accueil. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Internet : seulement pour envoyer le journal sur GitHub (si une clé a été donnée). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- MODE STANDARD (sans accessibilité, voir ModeStandard.kt) :
         - lire le journal d'utilisation d'Android (l'utilisateur l'autorise dans les réglages) ;
         - afficher le rideau par-dessus les autres apps ;
         - tourner en continu avec une notification (service « au premier plan »). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AnimApp"
        android:label="AnimLauncher"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- L'écran principal, avec son icône dans le tiroir d'applications. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- L'écran Journal (pas d'icône : on y accède depuis l'écran principal). -->
        <activity
            android:name=".JournalActivity"
            android:exported="false" />

        <!-- La liste des apps, et les réglages d'une app (durée, variantes, aperçu). -->
        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReglageAppActivity"
            android:exported="false" />

        <!-- Le service qui détecte l'app ouverte et joue l'animation. -->
        <service
            android:name=".AppWatcherService"
            android:exported="true"
            android:label="AnimLauncher"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Le MODE STANDARD : la détection sans accessibilité (prototype). -->
        <service
            android:name=".ModeStandard"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Détecte l'ouverture des apps pour jouer une animation de lancement" />
        </service>

        <!-- Le KILL SWITCH : un bouton dans le volet des réglages rapides. -->
        <service
            android:name=".InterrupteurTile"
            android:exported="true"
            android:icon="@android:drawable/ic_media_pause"
            android:label="AnimLauncher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
